# Public project URL. Safe to expose to the browser, but PortPass currently uses it server-side only.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only Supabase service role key. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Futprep staff access. Set these only in the hosting provider's secret/environment settings.
PORTPASS_FUTPREP_ADMIN_PIN=
PORTPASS_FUTPREP_COACH_PIN=
