# The settings the server reads. Names only: never commit a value. The full
# table (purpose, who sets each one, how often it is changed) is
# docs/security/env-vars.md, and lib/env.test.ts keeps the two in step.

# Supabase project URL. PortPass currently uses it server-side only.
SUPABASE_URL=

# Server-only Supabase secret key (sb_secret_...). Never commit the real value.
SUPABASE_SECRET_KEY=

# Supabase publishable key (sb_publishable_...). Not a secret, but still only
# read on the server: lib/auth uses it for Supabase Auth (sign-in codes).
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated emails that receive platform_owner on first sign-in. Set in
# Vercel, never in code.
PLATFORM_OWNER_EMAILS=

# Transactional email (Resend). PORTPASS_FROM_EMAIL is the PortPass sender;
# FUTPREP_FROM_EMAIL the Futprep one. Both must be on a verified domain.
RESEND_API_KEY=
PORTPASS_FROM_EMAIL=
FUTPREP_FROM_EMAIL=

# Shared secrets for the three protected endpoints. Each route refuses every
# call (503) until its secret is set.
# CRON_SECRET: Vercel sends it as a bearer token to /api/cron/* on schedule.
# RESEND_WEBHOOK_SECRET: the signing secret (whsec_...) of the Resend webhook
# that points at /api/webhooks/resend.
# BACKUP_HEARTBEAT_SECRET: the same value as HEARTBEAT_SECRET on the backup
# machine (scripts/backup/README.md).
CRON_SECRET=
RESEND_WEBHOOK_SECRET=
BACKUP_HEARTBEAT_SECRET=

# "true" once phone/WhatsApp codes exist (Twilio + Meta approval).
AUTH_PHONE_OTP_ENABLED=

# "true" to offer passkeys after a sign-in (Supabase's support is still beta).
AUTH_PASSKEYS_ENABLED=

# "1" renders the /entertainment section hero in the Night theme (black
# ground, gold eyebrow) -- Antonio's call; off by default.
ENTERTAINMENT_NIGHT_HERO=

# "1" renders Vercel's Web Analytics tag (/_vercel/insights/script.js).
# Only after Web Analytics is enabled for the project in Vercel (Project ->
# Analytics -> Enable); before that the script 404s for every visitor.
VERCEL_WEB_ANALYTICS=

# "1" renders Vercel's Speed Insights tag, on the same condition.
VERCEL_SPEED_INSIGHTS=

# Search Console and Bing Webmaster site verification tokens (public values).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Admin -> Leads (Scout). All optional; each switches one lookup on.
GOOGLE_PLACES_API_KEY=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_GRAPH_ACCESS_TOKEN=
ANTHROPIC_API_KEY=
SCOUT_MODEL=

# Where a new wedding enquiry is emailed (the Wedding Desk).
WEDDING_DESK_NOTIFY_EMAIL=
