# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# backup credentials (scripts/backup/README.md) -- only the .example is committed
scripts/backup/*.env
!scripts/backup/*.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
outputs/
work/

# Session scratch files (never committed)
/scratchpad/

# Claude Code: CLAUDE.md, .claude/agents and .claude/commands are shared
# with the repo; a session's worktrees and one person's local settings are not.
/.claude/worktrees/
/.claude/settings.local.json

# Graphify (Brief 30): each machine builds its own code map. It is about
# 8 MB and changes on every commit, so it is never committed, and neither is
# the backup graphify makes of .claude/settings.json when it adds its hooks.
/graphify-out/
/.claude/settings.json.graphify-bak
