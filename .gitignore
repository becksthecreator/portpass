scripts/backup/*.env
!scripts/backup/*.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
outputs/
work/

# Session scratch files (never committed)
/scratchpad/

# Claude Code: CLAUDE.md, .claude/agents and .claude/commands are shared
# with the repo; a session's worktrees and one person's local settings are not.
/.claude/worktrees/
/.claude/settings.local.json

# Private working files kept in the repo folder (19 Nov 2026). This repo is
# public: client documents, WhatsApp exports and local calculators never go
# in it. Root only, so the brand PDFs under public/brand/print stay tracked.
/whatsapp-export/
/*.docx
/*.pdf
/futprep-term2-calculator.html
/growth-playbook.html
/tsconfig.tsbuildinfo

# Look books are private and this repo is public: they live in Supabase
# Storage (bucket "lookbooks"), never here. See lib/lookbook/futprepDraft.ts.
/private/
*lookbook*/index.html
