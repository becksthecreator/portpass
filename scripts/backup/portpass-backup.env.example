# Copy to /etc/portpass-backup.env and `chmod 600` it. Placeholders only in
# this example -- the real file is never committed (see .gitignore).

# Supabase connection string. Use the *direct* or *session-mode pooler*
# connection (port 5432) from Supabase Dashboard -> Connect, not
# transaction mode: pg_dump needs a real session.
PORTPASS_DB_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Public key from `age-keygen` (starts with age1...). The matching private
# key does NOT live on this machine's backup disk -- see README.md.
AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_KEY

# Where encrypted dumps are written (nightly/ and monthly/ are created).
BACKUP_DIR=/var/backups/portpass

# --- restore-test.sh only ---
# Private key file (mode 600). Only needed on the machine running the test.
AGE_IDENTITY_FILE=/root/.config/age/portpass-backup-key.txt
# A LOCAL Postgres 17 with rights to create databases. Never Supabase.
SCRATCH_ADMIN_URL=postgresql://postgres@localhost:5432/postgres
